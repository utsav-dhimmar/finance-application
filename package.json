{
	"name": "finance-application",
	"private": true,
	"packageManager": "pnpm@10.33.4",
	"engines": {
		"node": ">=22"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"workerd",
			"lightningcss"
		]
	},
	"scripts": {
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test test:workers",
		"lint": "oxlint .",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check ."
	},
	"devDependencies": {
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2008",
		"turbo": "^2.11.10"
	}
}
