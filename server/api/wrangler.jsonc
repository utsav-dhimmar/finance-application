{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "finance-application-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	// D1 wiring is local-only for now: `wrangler dev` provisions a local SQLite
	// database for this binding without a Cloudflare account. The placeholder id
	// is replaced when a remote database is provisioned in a future change.
	"d1_databases": [
		{
			"binding": "finance_application",
			"database_name": "finance-application",
			"database_id": "fce29793-aa5b-49e5-b747-af353f30e64a",
			"migrations_dir": "migrations"
		}
	],
	// Serve the built SPA (apps/web) as static assets from this same worker:
	// matching files are served by the assets layer without invoking the
	// worker; /api/* goes to Hono first; anything else falls back to the
	// prerendered SPA shell so client-side routes survive hard refresh.
	"assets": {
		"directory": "../../apps/web/dist/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
  },
}
