{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Matches the Cloudflare Workers Builds project name, which overrides this
	// value on CI deploys — keeping them identical avoids the name-mismatch
	// warning and keeps local wrangler commands pointed at the real worker.
	"name": "finance-application",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	// D1 database (provisioned, remote): migrations applied with
	// `wrangler d1 migrations apply finance-application --remote`.
	"d1_databases": [
		{
			"binding": "finance_application",
			"database_name": "finance-application",
			"database_id": "fce29793-aa5b-49e5-b747-af353f30e64a",
			"migrations_dir": "migrations"
		}
	],
	// Fixed-window rate limiting for the auth endpoints: 100 requests per 60
	// seconds per key — tight enough to bound pre-auth password-hashing CPU,
	// loose enough for retries. Login keys include the submitted email;
	// register and refresh key on the client IP. Keys are separated in
	// lib/rate-limit.ts.
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 100,
				"period": 60
			}
		}
	],
	// Serve the built SPA (apps/web) as static assets from this same worker:
	// matching files are served by the assets layer without invoking the
	// worker; /api/* goes to Hono first; anything else falls back to the
	// prerendered SPA shell so client-side routes survive hard refresh.
	"assets": {
		"directory": "../../apps/web/dist/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": false,
			"head_sampling_rate": 1,
			"persist": true
		}
	}
}
