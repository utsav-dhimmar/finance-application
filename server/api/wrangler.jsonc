{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "finance-application-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	// D1 wiring is local-only for now: `wrangler dev` provisions a local SQLite
	// database for this binding without a Cloudflare account. The placeholder id
	// is replaced when a remote database is provisioned in a future change.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "finance-application",
			"database_id": "00000000-0000-0000-0000-000000000000"
		}
	]
}
