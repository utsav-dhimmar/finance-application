{
	"name": "finance-application",
	"private": true,
	"packageManager": "pnpm@10.33.4",
	"engines": {
		"node": ">=22"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"workerd"
		]
	},
